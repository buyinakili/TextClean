<Window x:Class="CleanText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="净文 CleanText"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        Width="400"
        Height="150"
        MinHeight="100">

    <Window.Resources>
        <!-- A quiet white surface; Mars green is reserved for meaningful actions. -->
        <SolidColorBrush x:Key="ThemeGreen" Color="#2DD4A3"/>
        <SolidColorBrush x:Key="ThemeGreenDark" Color="#168765"/>
        <SolidColorBrush x:Key="SurfaceBorder" Color="#DCE8E3"/>
        <SolidColorBrush x:Key="SoftGreen" Color="#EFF9F5"/>
        <SolidColorBrush x:Key="TitleButtonHover" Color="#EEF5F2"/>
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#71817A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TitleButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionIconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowDuration" Value="3000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E1F5ED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#CDECDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#E5F1EC" Margin="1,6" ClipToBounds="True">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,8,1000" RadiusX="4" RadiusY="4"/>
                            </Grid.Clip>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="{StaticResource ThemeGreen}" BorderThickness="0" MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14"
            Background="White"
            BorderBrush="{StaticResource SurfaceBorder}"
            BorderThickness="1"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar (drag handle) with top-left icon -->
            <Border x:Name="HeaderBar"
                    Grid.Row="0"
                    Background="Transparent"
                    CornerRadius="14,14,0,0"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- App icon, top-left -->
                    <Image Grid.Column="0" Source="/CleanText;component/icon.png"
                           Width="34" Height="34" Margin="15,7,0,5"
                           Stretch="Uniform" VerticalAlignment="Center"
                           SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,8,6">
                        <Button x:Name="SettingsBtn" Click="Settings_Click" Style="{StaticResource TitleButton}" ToolTip="设置" IsTabStop="False">
                            <Image Source="/CleanText;component/settings.png" Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="MinimizeBtn" Click="Minimize_Click" Style="{StaticResource TitleButton}" Content="&#x2013;" IsTabStop="False"/>
                        <Button x:Name="CloseBtn" Click="Close_Click" Style="{StaticResource TitleButton}" Content="&#x2715;" IsTabStop="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel x:Name="MainStack" Grid.Row="1" Margin="14,2,14,16">

                    <Border x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,0,0,8"
                            Padding="12" CornerRadius="10" Background="{StaticResource SoftGreen}"
                            BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" Foreground="#2B3C35" Margin="0,0,0,8"/>
                            <CheckBox x:Name="StartupCheckBox" Content="开机自启动" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" Margin="0,3"/>
                            <CheckBox x:Name="TopmostCheckBox" Content="悬浮在最上层" Checked="TopmostCheckBox_Changed" Unchecked="TopmostCheckBox_Changed" Margin="0,3"/>
                        </StackPanel>
                    </Border>

                    <!-- Input card -->
                    <Border x:Name="InputCard"
                            MinHeight="50"
                            CornerRadius="10"
                            Background="White"
                            BorderBrush="{StaticResource SurfaceBorder}"
                            BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="InputBox"
                                     HorizontalAlignment="Stretch"
                                     MinHeight="32"
                                     MaxHeight="200"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="14"
                                     Padding="10"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     CaretBrush="{StaticResource ThemeGreenDark}"
                                     Foreground="#1E2A26"
                                     TextChanged="InputBox_TextChanged"
                                     PreviewKeyDown="InputBox_PreviewKeyDown">
                                <TextBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SoftScrollBar}"/>
                                </TextBox.Resources>
                            </TextBox>
                            <Button x:Name="ClearBtn"
                                    Click="Clear_Click"
                                    Visibility="Collapsed"
                                    Style="{StaticResource ActionIconButton}"
                                    ToolTip="清空原文本"
                                    Background="White"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,20,10"
                                    Foreground="#7B8B85">
                                <Path Data="M19.7781746,4.22182541 C20.0710678,4.51471863 20.0710678,4.98959236 19.7781746,5.28248558 L5.28248558,19.7781746 C4.98959236,20.0710678 4.51471863,20.0710678 4.22182541,19.7781746 C3.92893219,19.4852814 3.92893219,19.0104076 4.22182541,18.7175144 L10.9395166,11.9994697 L4.22182541,5.28248558 C3.92893219,4.98959236 3.92893219,4.51471863 4.22182541,4.22182541 C4.51471863,3.92893219 4.98959236,3.92893219 5.28248558,4.22182541 L12,10.9389863 L18.7175144,4.22182541 C19.0104076,3.92893219 19.4852814,3.92893219 19.7781746,4.22182541 Z M19.7781746,18.7175144 C20.0710678,19.0104076 20.0710678,19.4852814 19.7781746,19.7781746 C19.4852814,20.0710678 19.0104076,20.0710678 18.7175144,19.7781746 L12.7072836,13.7675902 L13.767767,12.7071068 L19.7781746,18.7175144 Z"
                                      Fill="{StaticResource ThemeGreen}" Width="19.44" Height="19.44" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- The latest result replaces the prior one; its text scrolls inside the card. -->
                    <StackPanel x:Name="OutputStack" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
